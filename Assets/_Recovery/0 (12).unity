  m_Script: {fileID: 11500000, guid: ca224d27ce0fd144d972dc37fb61cdc1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HintManager
  hintText: {fileID: 4129950105698603358}
  steps:
  - activityId: activity_1
    title: Safety Before Work
    hint: Identify the required personal protective equipment and ensure it is properly worn before commencing work.
  - activityId: activity_2
    title: Light Bulb circuit
    hint: Identify the circuit components and connect them correctly on the red workbench. Ensure that the power supply is switched OFF before beginning the installation.
  - activityId: activity_3
    title: House Light
    hint: 'Using your demonstrated understanding of basic electrical circuits, identify and install the missing components required to complete the Fluorecent Light.


      Remember Electric breaker'
  - activityId: activity_4
    title: The Broken Stove
    hint: 'Inspect the faulty stove on the wooden workbench, identify and repair the defective components, then test it to verify that it is functioning correctly.


      Remember Electric breaker'
  - activityId: activity_5
    title: Clear Up After Work
    hint: Inspect the work area and ensure all tools, equipment, and materials are properly stored. Clean and organize the workspace.
  beforeStartMessage: Press Start Simulation to begin.
  allDoneMessage: All activities complete. Press Complete to see your results.
  sessionEndedMessage: The session has ended.
